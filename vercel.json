{
  "buildCommand": "ng build --configuration=prod",
  "outputDirectory": "dist/hoaiminh-erp",
  "rewrites": [
    {
      "source": "/api/proxy-identity/:path*",
      "destination": "http://identity.hoaiminh.vn/:path*"
    },
    {
      "source": "/api/proxy-api/:path*",
      "destination": "http://puyet1224-001:Puyet1224%40@puyet1224-001-site1.jtempurl.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
