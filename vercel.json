{
  "version": 2,
  "buildCommand": "ng build --configuration=prod",
  "outputDirectory": "dist/hoaiminh-erp",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "rewrites": [
    {
      "source": "/api/proxy-api/(.*)",
      "destination": "/api/proxy-api/$1"
    },
    {
      "source": "/api/proxy-identity/(.*)",
      "destination": "/api/proxy-identity/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
