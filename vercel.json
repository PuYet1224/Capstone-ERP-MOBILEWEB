{
  "buildCommand": "ng build --configuration=prod",
  "outputDirectory": "dist/hoaiminh-erp",
  "functions": {
    "api/proxy-api/[...path].js": {
      "maxDuration": 30
    },
    "api/proxy-identity/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With, Accept, Company, Language, Data-Type, Priority" }
      ]
    }
  ]
}
