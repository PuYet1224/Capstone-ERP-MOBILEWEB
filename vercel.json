{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "ng build --configuration=prod",
        "outputDirectory": "dist/hoaiminh-erp"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/proxy-api/(.*)",
      "dest": "/api/proxy-api/[...slug].js"
    },
    {
      "src": "/api/proxy-identity/(.*)",
      "dest": "/api/proxy-identity/[...slug].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
